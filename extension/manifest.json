{
  "manifest_version": 3,
  "name": "Polish - AI Text Rewriting",
  "version": "0.1.0",
  "description": "Rewrite selected text anywhere on the web with AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
"content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["src/content.js"],
    "css": ["src/content.css"],
    "all_frames": true
  }
]
}